model = "gpt-5.6-sol"
model_reasoning_effort = "medium"
openai_base_url = "https://cliproxy.modestlab.dev/v1"
mcp_oauth_callback_port = 12345

[tui]
status_line = ["model-with-reasoning", "current-dir", "context-usage", "used-tokens", "five-hour-limit", "weekly-limit"]
terminal_title = ["project", "git-branch", "status", "thread", "task-progress"]
screen_reader_detection_done = true

##### MCP SERVERS (rendered from playbook `mcp_servers`) #####
{% macro inline_table(d) %}{ {% for k, v in d.items() %}{{ k | to_json }} = {{ v | to_json }}{{ ', ' if not loop.last }}{% endfor %} }{% endmacro %}
{% for name, s in mcp_servers.items() %}

[mcp_servers.{{ name | to_json }}]
{% if s.url is defined %}
url = {{ s.url | to_json }}
{% if s.headers is defined %}
http_headers = {{ inline_table(s.headers) }}
{% endif %}
{% else %}
command = {{ s.command | to_json }}
args = {{ s.args | default([]) | to_json }}
{% if s.env is defined %}
env = {{ inline_table(s.env) }}
{% endif %}
{% endif %}
{% endfor %}

[marketplaces.ponytail]
source_type = "git"
source = "https://github.com/DietrichGebert/ponytail.git"

[plugins."ponytail@ponytail"]
enabled = true

[notice.model_migrations]
"gpt-5.6-sol" = "gpt-6-sol"

[hooks.state]

[hooks.state."ponytail@ponytail:hooks/claude-codex-hooks.json:session_start:0:0"]
